# Apple signing credentials for `npm run install:mac` / `npm run build:mac`.
# Copy this file to scripts/signing.env and fill in your values.
# scripts/signing.env is gitignored — never commit real credentials.

# Your Apple ID email (the one enrolled in the Developer Program)
APPLE_ID=you@example.com

# App-specific password from https://appleid.apple.com → Sign-In and Security
# → App-Specific Passwords (format: xxxx-xxxx-xxxx-xxxx)
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Team ID — find it at https://developer.apple.com/account
# → Membership details, or run: security find-identity -v -p codesigning
APPLE_TEAM_ID=XXXXXXXXXX
